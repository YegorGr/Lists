  node [shape=box, style="rounded,filled"];
  FREE [fillcolor="#57f157"];
  TAIL [fillcolor="#ff4af3"];
  HEAD [fillcolor="#9372f6"];

  { rank=same; FREE; node_2; }
  FREE -> node_2;
  { rank=same; TAIL; node_1; }
  TAIL -> node_1;
  { rank=same; HEAD; node_4; }
  HEAD -> node_4;

  node_0:n -> node_1 [weight=10, color="#1e88e5", penwidth=2];
  node_0:p -> node_4 [color="#43a047", constraint=false, style=dashed, penwidth=1.5];
