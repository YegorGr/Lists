  node_14:n -> node_15 [weight=100];
  node_15:n -> node_16 [weight=100];
  node_16:n -> node_17 [weight=100];
  node_17:n -> node_18 [weight=100];
  node_18:n -> node_19 [weight=100];
  node_19:n -> node_20 [weight=100];
  node_20:n -> node_0 [weight=100];
}
