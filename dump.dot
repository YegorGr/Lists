  node_2:n -> node_5 [weight=100];
  node_5:n -> node_6 [weight=100];
  node_6:n -> node_7 [weight=100];
  node_7:n -> node_8 [weight=100];
  node_8:n -> node_9 [weight=100];
  node_9:n -> node_10 [weight=100];
  node_10:n -> node_11 [weight=100];
