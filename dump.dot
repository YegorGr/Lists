digraph G {
  rankdir=TB;
  ranksep=0.35;
  node [fontname="Calibri", fontsize=14];

  table_node [shape=plaintext, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5">
      <TR><TD><B>idx</B></TD><TD><B>data</B></TD><TD><B>next</B></TD><TD><B>prev</B></TD><TD><B>status</B></TD></TR>
      <TR><TD>0</TD><TD>0</TD><TD>1</TD><TD>7</TD><TD>SENTINEL</TD></TR>
      <TR><TD>1</TD><TD>11</TD><TD>3</TD><TD>0</TD><TD>USED</TD></TR>
      <TR><TD>2</TD><TD>0</TD><TD>8</TD><TD>-1</TD><TD>FREE</TD></TR>
      <TR><TD>3</TD><TD>22</TD><TD>4</TD><TD>1</TD><TD>USED</TD></TR>
      <TR><TD>4</TD><TD>22</TD><TD>6</TD><TD>3</TD><TD><FONT COLOR="red"><B>ERROR</B></FONT></TD></TR>
      <TR><TD>5</TD><TD>22</TD><TD>6</TD><TD>4</TD><TD><FONT COLOR="red"><B>ERROR</B></FONT></TD></TR>
      <TR><TD>6</TD><TD>33</TD><TD>7</TD><TD>5</TD><TD>USED</TD></TR>
      <TR><TD>7</TD><TD>44</TD><TD>0</TD><TD>6</TD><TD>USED</TD></TR>
      <TR><TD>8</TD><TD>0</TD><TD>9</TD><TD>-1</TD><TD>FREE</TD></TR>
      <TR><TD>9</TD><TD>0</TD><TD>10</TD><TD>-1</TD><TD>FREE</TD></TR>
      <TR><TD>10</TD><TD>0</TD><TD>0</TD><TD>-1</TD><TD>FREE</TD></TR>
    </TABLE>
  >];

  node_0 [shape=record, style=filled, fillcolor="#dd8007", label="{ INDEX = 0 | DATA = 0 | { <n> NEXT = 1 | <p> PREV = 7 | meow } }"];
  node_1 [shape=record, style=filled, fillcolor="#ff4af3", label="{ INDEX = 1 | DATA = 11 | { <n> NEXT = 3 | <p> PREV = 0 | meow } }"];
  node_2 [shape=record, style=filled, fillcolor="#57f157", label="{ INDEX = 2 | DATA = FREE | { <n> NEXT = 8 | <p> PREV = -1 | meow } }"];
  node_3 [shape=record, style=filled, fillcolor="#2f7bfe", label="{ INDEX = 3 | DATA = 22 | { <n> NEXT = 4 | <p> PREV = 1 | meow } }"];
  node_4 [shape=record, style=filled, fillcolor="#ff4d4d", label="{ INDEX = 4 | DATA = 22 | { <n> NEXT = 6 | <p> PREV = 3 | meow } }"];
  node_5 [shape=record, style=filled, fillcolor="#ff4d4d", label="{ INDEX = 5 | DATA = 22 | { <n> NEXT = 6 | <p> PREV = 4 | meow } }"];
  node_6 [shape=record, style=filled, fillcolor="#2f7bfe", label="{ INDEX = 6 | DATA = 33 | { <n> NEXT = 7 | <p> PREV = 5 | meow } }"];
  node_7 [shape=record, style=filled, fillcolor="#9372f6", label="{ INDEX = 7 | DATA = 44 | { <n> NEXT = 0 | <p> PREV = 6 | meow } }"];
  node_8 [shape=record, style=filled, fillcolor="#57f157", label="{ INDEX = 8 | DATA = FREE | { <n> NEXT = 9 | <p> PREV = -1 | meow } }"];
  node_9 [shape=record, style=filled, fillcolor="#57f157", label="{ INDEX = 9 | DATA = FREE | { <n> NEXT = 10 | <p> PREV = -1 | meow } }"];
  node_10 [shape=record, style=filled, fillcolor="#57f157", label="{ INDEX = 10 | DATA = FREE | { <n> NEXT = 0 | <p> PREV = -1 | meow } }"];

  node [shape=box, style="rounded,filled"];
  FREE [fillcolor="#57f157"];
  TAIL [fillcolor="#ff4af3"];
  HEAD  [fillcolor="#9372f6"];
  ERROR [fillcolor="#ff4d4d"];

  { rank=same; FREE; node_2; }
  FREE -> node_2;
  { rank=same; TAIL; node_1; }
  TAIL -> node_1;
  { rank=same; HEAD; node_7; }
  HEAD -> node_7;

  node_0:n -> node_1 [rank=same, weight=100, color="#1e88e5", penwidth=1.5];
  node_0:p -> node_7 [rank=same, color="#43a047", constraint=false, style=dashed, penwidth=1.5];
  node_1:n -> node_3 [rank=same, weight=100, color="#1e88e5", penwidth=1.5];
  node_1:p -> node_0 [rank=same, color="#43a047", constraint=false, style=dashed, penwidth=1.5];
  node_3:n -> node_4 [rank=same, weight=100, color="#1e88e5", penwidth=1.5];
  node_3:p -> node_1 [rank=same, color="#43a047", constraint=false, style=dashed, penwidth=1.5];
  node_4:n -> node_6 [rank=same, weight=100, color="#ff0000", penwidth=1.5];
  node_4:p -> node_3 [rank=same, color="#43a047", constraint=false, style=dashed, penwidth=1.5];
  node_5:n -> node_6 [rank=same, weight=100, color="#1e88e5", penwidth=1.5];
  node_5:p -> node_4 [rank=same, color="#ff0000", constraint=false, style=dashed, penwidth=1.5];
  node_6:n -> node_7 [rank=same, weight=100, color="#1e88e5", penwidth=1.5];
  node_6:p -> node_5 [rank=same, color="#43a047", constraint=false, style=dashed, penwidth=1.5];
  node_7:n -> node_0 [rank=same, constraint=false, color="#1e88e5", penwidth=1.5];
  node_7:p -> node_6 [rank=same, color="#43a047", constraint=false, style=dashed, penwidth=1.5];
  node_2:n -> node_8 [weight=100];
  node_8:n -> node_9 [weight=100];
  node_9:n -> node_10 [weight=100];
  node_10:n -> node_0 [weight=100];
}
